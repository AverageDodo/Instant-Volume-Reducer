<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained, single-file release build for 64-bit Windows.
  Usage: dotnet publish src\InstantVolumeReducer\InstantVolumeReducer.csproj -p:PublishProfile=win-x64
  Output: src\InstantVolumeReducer\bin\publish\win-x64\InstantVolumeReducer.exe
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Compression halves the exe size but makes the always-running process use ~4x the private
         memory (the bundled assemblies are unpacked into memory), so it's off for a tray app. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- WinForms doesn't support trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <PublishDir>bin\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
